# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Flux SSE : un seul événement puis fermeture (tests rapides)
REALTIME_SSE_DUREE=0
# Simulation en temps réel dans les tests
SIMULATION_FACTEUR_TEMPS=1
# Horloge figée dans les tests : pas de délai minimal anti-robot
ANTIBOT_DELAI_MIN=0
INFIRMERIE_SORTIE_AUTOMATIQUE=0
INFIRMERIE_FATIGUE_PAR_ETAPE=0
# Verrous isolés du worker de développement (flock partagerait /tmp avec lui).
LOCK_DSN=in-memory
