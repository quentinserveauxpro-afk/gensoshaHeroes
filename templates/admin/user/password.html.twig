{% extends 'base.html.twig' %}
{% block title %}Mot de passe — {{ compte.email }}{% endblock %}
{% block content %}
    <nav class="label-md" aria-label="Fil d'Ariane"><a href="{{ path('app_admin_user_index') }}">Utilisateurs</a> › {{ compte.email }}</nav>
    <h1 class="headline-lg">Réinitialiser le mot de passe</h1>
    {{ form_start(form, {attr: {class: 'card stack', novalidate: 'novalidate'}}) }}
        <p class="muted" style="margin:0">Le nouveau mot de passe remplace immédiatement l'ancien pour {{ compte.nom }} ({{ compte.email }}).</p>
        <div class="form-grid">{{ form_row(form.plainPassword.first) }}{{ form_row(form.plainPassword.second) }}</div>
        <div class="row">
            <button type="submit" class="btn btn--primary">Réinitialiser</button>
            <a class="btn btn--soft" href="{{ path('app_admin_user_index') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
