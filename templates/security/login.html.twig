{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
    <main class="auth">
        <div class="card stack">
            <div class="brand" style="padding:0">
                <span class="brand__logo">{{ include('components/_icon.html.twig', {name: 'shield'}) }}</span>
                <span><span class="brand__name">GENOSHA HEROES</span><br><span class="brand__sub">Système de commandement</span></span>
            </div>
            <h1 class="headline-md">Authentification</h1>
            {% if error %}<div class="flash flash--danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
            <form method="post" action="{{ path('app_login') }}" class="stack">
                <div class="field"><label for="username">E-mail</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus></div>
                <div class="field"><label for="password">Mot de passe</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required></div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn btn--primary btn--block">Se connecter</button>
            </form>
        </div>
    </main>
{% endblock %}
