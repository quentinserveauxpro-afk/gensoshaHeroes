{# Carte de mission. Paramètres : mission, selected (bool), url (lien de sélection) #}
{% set equipe = mission.herosAffectes %}
<article class="card mission-card" {% if selected|default(false) %}aria-current="true"{% endif %}>
    <div class="row row--between">
        {{ include('components/_mission_badge.html.twig') }}
        {% if equipe is empty and mission.niveauUrgence.urgent %}
            <span class="label-sm text-danger">Urgent</span>
        {% else %}
            {{ include('components/_timer.html.twig') }}
        {% endif %}
    </div>
    <h3 class="mission-card__title"><a href="{{ url|default(path('app_tactical_center', {mission: mission.id})) }}">{{ mission.nom }}</a></h3>
    <p class="muted" style="margin:0">{{ mission.localisation ?? mission.description|tronquer(80) }}</p>
    {% if equipe is not empty %}
        <div class="mission-card__meta">
            <span>Succès estimé : <strong style="font-size:15px">{{ mission.tauxDeReussite }}%</strong></span>
            <span>{{ include('components/_icon.html.twig', {name: 'near_me'}) }} {{ distance_km(equipe|first, mission) }} km</span>
        </div>
        {{ include('components/_gauge.html.twig', {value: mission.tauxDeReussite, label: null, thin: true}) }}
        <div class="row row--between">
            <span class="row" style="gap:.4rem">
                <span class="avatar-stack">{% for hero in equipe %}{{ include('components/_hero_avatar.html.twig', {hero: hero, size: 30}) }}{% endfor %}</span>
                <span class="label-md">{{ equipe|map(h => h.nom)|join(', ') }}</span>
            </span>
            <a class="btn btn--soft btn--sm" href="{{ path('app_mission_show', {id: mission.id}) }}">Détails</a>
        </div>
    {% else %}
        <div class="panel row row--between label-md">
            <span>{{ include('components/_icon.html.twig', {name: 'person_off'}) }} Aucune unité engagée</span>
            <span>{{ mission.tailleEquipeMinimale }}–{{ mission.tailleEquipeMaximale }} héros requis</span>
        </div>
        <a class="btn btn--dark btn--block" href="{{ path('app_squad_builder_mission', {id: mission.id}) }}">
            {{ include('components/_icon.html.twig', {name: 'group_add'}) }} Constituer Escouade
        </a>
    {% endif %}
</article>
