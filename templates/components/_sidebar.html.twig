{% set route = app.current_route %}
{# Liens filtrés par rôle : simple confort d'affichage, l'accès réel est contrôlé côté serveur. #}
{% set liens = [
    {route: 'app_tactical_center', label: 'Centre Tactique', icon: 'radar', actif: route == 'app_tactical_center', visible: true},
    {route: 'app_squad_builder', label: 'Squad Builder', icon: 'groups', actif: route starts with 'app_squad_builder', visible: is_granted('ROLE_HERO_OPERATOR')},
    {route: 'app_hero_index', label: 'Roster des Héros', icon: 'shield_person', actif: route starts with 'app_hero', visible: true},
    {route: 'app_mission_index', label: 'Missions', icon: 'flag', actif: route starts with 'app_mission', visible: true},
    {route: 'app_infirmerie', label: 'Infirmerie', icon: 'local_hospital', actif: route starts with 'app_infirmerie', visible: is_granted('INFIRMERIE_CONSULTER')},
    {route: 'app_requete_index', label: 'Requêtes Citoyennes', icon: 'sensors', actif: route starts with 'app_requete', visible: is_granted('REQUETE_CONSULTER')},
] %}
<aside class="sidebar" aria-label="Navigation principale">
    <a class="brand" href="{{ path('app_tactical_center') }}">
        <span class="brand__logo">{{ include('components/_icon.html.twig', {name: 'shield'}) }}</span>
        <span>
            <span class="brand__name">GENOSHA<br>HEROES</span><br>
            <span class="brand__sub">Système de commandement</span>
        </span>
    </a>
    {{ include('components/_badge.html.twig', {label: 'Réseau défense actif', tone: 'muted', dot: true, class: 'network-badge'}) }}
    <nav class="nav">
        {% for lien in liens|filter(l => l.visible) %}
            <a class="nav__link" href="{{ path(lien.route) }}" {% if lien.actif %}aria-current="page"{% endif %}>
                {{ include('components/_icon.html.twig', {name: lien.icon}) }} {{ lien.label }}
            </a>
        {% endfor %}
        {% if is_granted('ROLE_ADMIN') %}
            <span class="nav__section label-sm">Administration</span>
            <a class="nav__link" href="{{ path('app_admin_villain_index') }}" {% if route starts with 'app_admin_villain' %}aria-current="page"{% endif %}>
                {{ include('components/_icon.html.twig', {name: 'skull'}) }} Vilains
            </a>
            <a class="nav__link" href="{{ path('app_admin_user_index') }}" {% if route starts with 'app_admin_user' %}aria-current="page"{% endif %}>
                {{ include('components/_icon.html.twig', {name: 'manage_accounts'}) }} Utilisateurs
            </a>
        {% endif %}
    </nav>
    <div class="sidebar__footer">
        {% if app.user %}
            <div class="operator">
                <span class="avatar" style="--s:40px">{{ app.user.nom|slice(0, 2)|upper }}</span>
                <span>
                    <span class="operator__name">{{ app.user.nom }}</span><br>
                    <span class="label-md muted">{{ app.user.fonction ?? role_libelle(app.user.roles|filter(r => r != 'ROLE_USER')|first|default('ROLE_USER')) }}</span>
                </span>
            </div>
        {% endif %}
        <div class="sysline">
            <span>{{ include('components/_icon.html.twig', {name: 'schedule'}) }} SYSTÈME : <time data-controller="clock">{{ 'now'|date('H:i:s', 'UTC') }}</time> UTC</span>
            <span>SEC-LVL {{ is_granted('ROLE_ADMIN') ? 4 : 2 }}</span>
        </div>
    </div>
</aside>
