{# Compte à rebours : valeur de référence serveur, actualisée par le contrôleur Stimulus « countdown ».
   Paramètres : mission, big (bool) #}
{% set t = mission_timer(mission) %}
<span class="timer{% if big|default(false) %} timer--big{% endif %}{% if t.termine %} timer--done{% endif %}"
      data-controller="countdown"
      data-countdown-seconds-value="{{ t.secondesRestantes }}"
      data-countdown-url-value="{{ path('app_api_mission_timer', {id: mission.id}) }}"
      role="timer" aria-live="off" aria-label="Temps restant">
    {%- if not big|default(false) %}{{ include('components/_icon.html.twig', {name: 'schedule'}) }}{% endif -%}
    <span data-countdown-target="output">{{ t.libelle }}</span>
</span>
